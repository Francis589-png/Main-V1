{
  "rules": {
    "users": {"$uid": {".read":"auth != null && auth.uid === $uid",".write":"auth != null && auth.uid === $uid",".validate":"newData.hasChildren(['uid','email','createdAt']) && newData.child('uid').val() === auth.uid","uid":{".validate":"newData.val() === auth.uid"},"email":{".validate":"newData.isString()"},"createdAt":{".validate":"newData.isNumber()"},"$other":{".validate":true}}},
    "publicProfiles": {"$uid": {".read":"auth != null",".write":"auth != null && auth.uid === $uid",".validate":"newData.hasChildren(['uid','displayName']) && newData.child('uid').val() === $uid","uid":{".validate":"newData.val() === $uid"},"displayName":{".validate":"newData.isString() && newData.val().length <= 80"},"photoURL":{".validate":"!newData.exists() || newData.isString()"},"bio":{".validate":"!newData.exists() || (newData.isString() && newData.val().length <= 280)"},"mood":{".validate":"!newData.exists() || (newData.isString() && newData.val().length <= 80)"},"location":{".validate":"!newData.exists() || (newData.hasChildren(['lat','lng']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90 && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180)"},"$other":{".validate":true}}},
    "presence": {"$uid":{".read":"auth != null",".write":"auth != null && auth.uid === $uid","online":{".validate":"newData.isBoolean()"},"lastSeen":{".validate":"newData.isNumber()"}}},
    "typing": {"$chatId":{"$uid":{".read":"auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",".write":"auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",".validate":"newData.isNumber() || !newData.exists()"}}},
    "connections": {"$connectionId":{".read":"auth != null && (data.child('userA').val() === auth.uid || data.child('userB').val() === auth.uid)",".write":"auth != null && (newData.child('userA').val() === auth.uid || newData.child('userB').val() === auth.uid)",".validate":"newData.hasChildren(['id','userA','userB','status','requestedBy','updatedAt']) && newData.child('id').val() === $connectionId && newData.child('userA').isString() && newData.child('userB').isString() && newData.child('status').isString() && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'connected' || newData.child('status').val() === 'declined') && ((newData.child('status').val() === 'pending' && newData.child('requestedBy').val() === auth.uid) || (newData.child('status').val() === 'connected' && data.child('status').val() === 'pending' && data.child('requestedBy').val() !== auth.uid) || (newData.child('status').val() === 'declined' && data.child('status').val() === 'pending' && data.child('requestedBy').val() !== auth.uid))"}},
    "connectionsByUser": {"$uid":{"$otherUid":{".read":"auth != null && auth.uid === $uid",".write":"auth != null && (auth.uid === $uid || auth.uid === $otherUid)",".validate":"newData.hasChildren(['id','userA','userB','status','requestedBy','updatedAt']) && newData.child('id').val() === [auth.uid,$otherUid].sort().join('_') && newData.child('status').isString() && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'connected' || newData.child('status').val() === 'declined')"}},
    "userChats": {"$uid":{".read":"auth != null && auth.uid === $uid","$chatId":{".write":"auth != null && (auth.uid === $uid || root.child('chats').child($chatId).child('members').child(auth.uid).exists())"}}},
    "chats": {"$chatId":{".read":"auth != null && data.child('members').child(auth.uid).exists() && root.child('connections').child($chatId).child('status').val() === 'connected'",".write":"auth != null && ((!data.exists() && newData.child('members').child(auth.uid).exists() && root.child('connections').child($chatId).child('status').val() === 'connected') || (data.exists() && data.child('members').child(auth.uid).exists() && root.child('connections').child($chatId).child('status').val() === 'connected'))","members":{"$uid":{".validate":"newData.val() === true"}},"type":{".validate":"newData.val() === 'direct'"},"lastMessage":{".validate":"!newData.exists() || (newData.isString() && newData.val().length <= 4000)"},"lastSenderId":{".validate":"!newData.exists() || newData.val() === auth.uid"},"updatedAt":{".validate":"!newData.exists() || newData.val().isNumber() || newData.val() === null"}},
    "messages": {"$chatId":{".read":"auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && root.child('connections').child($chatId).child('status').val() === 'connected'","$messageId":{".write":"auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && root.child('connections').child($chatId).child('status').val() === 'connected' && (!data.exists() ? newData.child('senderId').val() === auth.uid : data.child('senderId').val() === auth.uid)",".validate":"newData.hasChildren(['senderId','createdAt','type']) && newData.child('senderId').isString() && newData.child('createdAt').isNumber() && newData.child('type').val() === 'text' && newData.child('text').isString() && newData.child('text').val().length <= 4000","readBy":{"$uid":{".write":"auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && root.child('connections').child($chatId).child('status').val() === 'connected'",".validate":"newData.val() === true"}}}}}
  }
}
